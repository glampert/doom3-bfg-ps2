// Graybox materials: collision only until the world cook compiles material passes (gate R2);
// the cook job gives each one its base colour. Without stages id refuses them decals, which
// opaque drawn materials accept; forceOverlays restores that.
textures/graybox/floor_light { solid collision forceOverlays }
textures/graybox/floor_dark { solid collision forceOverlays }
textures/graybox/wall { solid collision forceOverlays }
textures/graybox/ceiling { solid collision forceOverlays }
textures/graybox/trim { solid collision forceOverlays }
textures/graybox/red { solid collision forceOverlays }
textures/graybox/green { solid collision forceOverlays }
textures/graybox/blue { solid collision forceOverlays }
textures/graybox/yellow { solid collision forceOverlays }
textures/graybox/orange { solid collision forceOverlays }
textures/graybox/cyan { solid collision forceOverlays }
textures/graybox/magenta { solid collision forceOverlays }
textures/graybox/white { solid collision forceOverlays }
