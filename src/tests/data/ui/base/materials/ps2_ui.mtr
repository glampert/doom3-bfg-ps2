// Authored native SWF materials use backend-owned white and cooked movie/font pages.

_white
{
    {
        blend blend
        map _white
        nearest
        clamp
        vertexColor
    }
}

guiSolid
{
    {
        blend blend
        map _white
        nearest
        clamp
        vertexColor
    }
}

generated/swf/ps2_demo.tga
{
    {
        blend blend
        map textures/ps2_movie
        nearest
        clamp
        vertexColor
    }
}

newfonts/ps2_ascii/48.tga
{
    {
        blend blend
        map textures/ps2_ascii
        nearest
        clamp
        vertexColor
    }
}
